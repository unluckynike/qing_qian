# 数据库(与 docker-compose.yml 对应)
DATABASE_URL=postgresql+psycopg2://qingqian:qingqian_dev@localhost:5432/qingqian

# AI 解签(OpenAI 兼容接口;默认智谱 GLM,可换成任意兼容端点)
# 未配置 LLM_API_KEY 时:抽签与静态签文可用,AI 解签返回 503
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=1200
# 推理型模型(如方舟 deepseek 系列)可设 disabled 关闭思考过程,直接输出正文
LLM_THINKING=

# 前端开发服务器跨域来源(逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 后台管理(单管理员账号;/admin 页面登录;公开部署前务必改密码)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_HOURS=12

# 普通用户会话签名密钥(公开部署前务必修改)
USER_SECRET=
USER_TOKEN_DAYS=7
